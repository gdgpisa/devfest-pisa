# Build assets include content hashes and can be cached across page visits.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Force disable caching for service worker
/service-worker.js
  Cache-Control: no-store, no-cache, must-revalidate, proxy-revalidate
  Pragma: no-cache
  Expires: 0
  Surrogate-Control: no-store

# For any other paths containing service worker files
/*service-worker*.js
  Cache-Control: no-store, no-cache, must-revalidate, proxy-revalidate
  Pragma: no-cache
  Expires: 0
  Surrogate-Control: no-store
