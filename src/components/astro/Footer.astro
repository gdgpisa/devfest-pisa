---
const social = [
    { href: 'https://gdgpisa.it/telegram', label: 'Telegram' },
    { href: 'https://instagram.com/gdgpisa', label: 'Instagram' },
    { href: 'https://linkedin.com/company/gdg-pisa', label: 'LinkedIn' },
    { href: 'https://facebook.com/gdg.pisa', label: 'Facebook' },
    { href: 'https://www.youtube.com/@gdgpisa4445', label: 'YouTube' },
]

const about = [
    { href: 'https://gdgpisa.it/', label: 'GDG Pisa' },
    { href: 'https://developers.google.com/groups/', label: 'Google Developer Groups' },
    { href: 'https://devfest.withgoogle.com/', label: 'DevFest' },
]

const pastEditions = [
    { href: 'https://2018.devfest.gdgpisa.it/', label: 'DevFest Pisa 0.1' },
    { href: 'https://2019.devfest.gdgpisa.it/', label: 'DevFest Pisa 2019' },
    { href: 'https://2020.devfest.gdgpisa.it/', label: 'DevFest Pisa 2020' },
    { href: 'https://2023.devfest.gdgpisa.it/', label: 'DevFest Pisa 2023' },
    { href: 'https://2024.devfest.gdgpisa.it/', label: 'DevFest Pisa 2024' },
    { href: 'https://2025.devfest.gdgpisa.it/', label: 'DevFest Pisa 2025' },
    { href: 'https://2026.devfest.gdgpisa.it/', label: 'DevFest Pisa 2026' },
]

const resources = [
    {
        href: 'https://docs.google.com/document/d/1TbuETYCizEvvVMRBR9kTFsLT-X2X5NS7GlV43IZO0xM/edit?usp=sharing',
        label: 'Partnership proposal (Italian)',
    },
    { href: '/code-of-conduct', label: 'Code of Conduct' },
    { href: '/faq', label: 'FAQs' },
    { href: 'https://github.com/gdgpisa/devfest-pisa', label: 'Source code on GitHub' },
]

const columns = [
    { title: 'Follow GDG Pisa', links: social, email: true },
    { title: 'About', links: about },
    { title: 'Past DevFests', links: pastEditions },
    { title: 'Event resources', links: resources },
]

// Fibonacci colour bar: 1, 1, 2, 3, 5, 8
const bar = [
    { flex: 1, color: 'var(--blue)' },
    { flex: 1, color: 'var(--green)' },
    { flex: 2, color: 'var(--yellow)' },
    { flex: 3, color: 'var(--red)' },
    { flex: 5, color: 'var(--blue)' },
    { flex: 8, color: 'var(--green)' },
]
---

<footer class="site-footer">
    <div class="wrap site-footer__inner">
        <div class="site-footer__cols">
            {
                columns.map(col => (
                    <div class="site-footer__col">
                        <div class="eyebrow site-footer__label">{col.title}</div>
                        {col.email && (
                            <a class="mono site-footer__email" href="mailto:pisagdg@gmail.com">
                                pisagdg@gmail.com
                            </a>
                        )}
                        {col.links.map(link => (
                            <a href={link.href}>{link.label}</a>
                        ))}
                    </div>
                ))
            }
        </div>
        <p class="site-footer__copy">Made by GDG &amp; WTM Pisa · © GDG Pisa 2027</p>
    </div>
    <div class="site-footer__bar" aria-hidden="true">
        {bar.map(seg => <div style={`flex: ${seg.flex}; background: ${seg.color};`} />)}
    </div>
</footer>

<style>
    .site-footer {
        background: var(--ink);
        color: var(--surface);
    }

    .site-footer__inner {
        padding-top: var(--space-55);
        padding-bottom: var(--space-34);
        display: flex;
        flex-direction: column;
        gap: var(--space-34);
    }

    .site-footer__cols {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: var(--space-34);
        font: 400 16px/26px var(--font-sans);
    }

    .site-footer__col {
        display: flex;
        flex-direction: column;
        gap: var(--space-8);
    }

    .site-footer__label {
        color: #b4b4b4;
    }

    .site-footer a {
        color: var(--surface);
    }

    .site-footer a:hover {
        color: #b4b4b4;
    }

    .site-footer__email {
        font-size: 13px;
    }

    .site-footer__copy {
        margin: 0;
        font: 400 13px/21px var(--font-sans);
        color: #b4b4b4;
    }

    .site-footer__bar {
        display: flex;
        height: 21px;
    }
</style>
