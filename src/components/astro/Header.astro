---
import LocationLockup from '@/components/astro/LocationLockup.astro'

const links = [
    { href: '/location', label: 'Location' },
    { href: '/team', label: 'Team' },
]
---

<header class="site-header">
    <nav class="wrap site-nav" aria-label="Main">
        <a href="/" class="site-nav__brand" aria-label="DevFest Pisa, home">
            <LocationLockup class="site-nav__logo" />
        </a>
        <div class="site-nav__spacer"></div>
        <div class="site-nav__links">
            {links.map(link => <a href={link.href}>{link.label}</a>)}
        </div>
        <a class="dp-btn dp-btn--outline" href="https://gdgpisa.it/telegram">Get updates on Telegram</a>
    </nav>
</header>

<style>
    .site-nav {
        padding-top: var(--space-21);
        padding-bottom: var(--space-21);
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-21);
    }

    .site-nav__brand {
        display: flex;
        align-items: center;
        text-decoration: none;
    }

    /* Minimum width of the lockup is 160px (brand book) */
    .site-nav__brand :global(.site-nav__logo) {
        width: 196px;
    }

    .site-nav__spacer {
        flex: 1 1 auto;
    }

    .site-nav__links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-8) var(--space-34);
        font: 500 16px/26px var(--font-sans);
    }

    .site-nav__links a {
        text-decoration: none;
    }

    @media (max-width: 760px) {
        .site-nav__spacer {
            display: none;
        }

        .site-nav__links {
            flex-basis: 100%;
            gap: var(--space-8) var(--space-21);
        }
    }
</style>
