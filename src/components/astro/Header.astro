---
import devfestLogoSvg from '@/assets/devfest-logo.svg'

const links = [
    { href: '/location', label: 'Location' },
    { href: '/team', label: 'Team' },
]
---

<header class="site-header">
    <nav class="wrap site-nav" aria-label="Main">
        <a href="/" class="site-nav__brand">
            <img class="site-nav__logo" src={devfestLogoSvg.src} alt="" width="223" height="148" />
            DevFest Pisa 2027
        </a>
        <div class="site-nav__spacer"></div>
        <div class="site-nav__links">
            {links.map(link => <a href={link.href}>{link.label}</a>)}
        </div>
        <a class="dp-btn dp-btn--outline" href="https://gdgpisa.it/telegram">Get updates on Telegram</a>
    </nav>
</header>

<style>
    /* Full width, like the hero below, instead of the centred 1280px column */
    .site-nav.wrap {
        max-width: none;
        padding-left: var(--space-34);
        padding-right: var(--space-34);
    }

    .site-nav {
        padding-top: 10px;
        padding-bottom: 10px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-21);
    }

    .site-nav__brand {
        display: flex;
        align-items: center;
        gap: var(--space-8);
        font: 500 22px/1 var(--font-sans);
        color: inherit;
        text-decoration: none;
        white-space: nowrap;
    }

    .site-nav__logo {
        height: 40px;
        width: auto;
    }

    .site-nav__spacer {
        flex: 1 1 auto;
    }

    .site-nav__links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-8) var(--space-34);
        font: 500 16px/26px var(--font-sans);
    }

    .site-nav__links a {
        text-decoration: none;
    }

    @media (max-width: 760px) {
        .site-nav.wrap {
            padding-left: 16px;
            padding-right: 16px;
        }

        .site-nav__spacer {
            display: none;
        }

        .site-nav__links {
            flex-basis: 100%;
            gap: var(--space-8) var(--space-21);
        }
    }
</style>
