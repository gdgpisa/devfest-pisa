---
// Full-bleed golden rectangle (8 x 5). Children are placed with the
// .fib__s5 / .fib__s3 / .fib__s2 / .fib__s1a / .fib__s1b classes.
import Spiral from '@/components/astro/Spiral.astro'

type Props = {
    label?: string
}

const { label } = Astro.props
---

<section class="fib-section" aria-label={label}>
    <div class="fib">
        <slot />
        <Spiral />
        <svg class="fib__mobile-spiral" viewBox="0 3 3 2" preserveAspectRatio="xMidYMid meet" aria-hidden="true">
            <path d="M3 3 A2 2 0 0 1 1 5 A1 1 0 0 1 0 4 A1 1 0 0 1 1 3"></path>
        </svg>
    </div>
</section>

<style is:global>
    .fib {
        display: grid;
        grid-template-columns: repeat(8, minmax(0, 1fr));
        grid-template-rows: repeat(5, minmax(0, 1fr));
        height: calc(100vh - var(--site-header-height));
        width: 100%;
        position: relative;
        background: var(--surface-raised);
        container-type: size;
        border-bottom: var(--stroke-3) solid var(--ink);
    }

    .fib__cell {
        min-width: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        padding: clamp(16px, 2.6vw, 55px);
        position: relative;
    }

    .fib__s5 {
        grid-column: 1 / 6;
        grid-row: 1 / 6;
        border-right: var(--stroke-2) solid var(--ink);
    }

    .fib__s3 {
        grid-column: 6 / 9;
        grid-row: 1 / 4;
        border-bottom: var(--stroke-2) solid var(--ink);
    }

    .fib__s2 {
        grid-column: 7 / 9;
        grid-row: 4 / 6;
        border-left: var(--stroke-2) solid var(--ink);
    }

    .fib__s1a {
        grid-column: 6 / 7;
        grid-row: 4 / 5;
        border-bottom: var(--stroke-2) solid var(--ink);
    }

    .fib__s1b {
        grid-column: 6 / 7;
        grid-row: 5 / 6;
    }

    /* Content sits in the corner the spiral turns around */
    .fib__s5.fib__cell {
        justify-content: flex-end;
        align-items: flex-end;
        text-align: right;
        gap: var(--space-21);
    }

    .fib__s5 > * {
        position: relative;
        z-index: 1;
    }

    .fib__mobile-spiral {
        display: none;
    }

    @media (max-width: 760px) {
        .fib-section {
            container-type: inline-size;
        }

        .fib {
            --tile-unit: calc(100cqw / 3);
            height: auto;
            min-height: calc(100dvh - var(--site-header-height));
            container-type: inline-size;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            /* Keep the lower 2×2, 1×1, 1×1 Fibonacci tiles square. */
            grid-template-rows: minmax(min-content, 1fr) repeat(2, var(--tile-unit));
            background: var(--yellow);
        }

        .hero-primary {
            grid-column: 1 / 4;
            grid-row: 1;
            min-height: min-content;
        }

        .fib__s2 {
            grid-column: 1 / 3;
            grid-row: 2 / 4;
            border-left: 0;
            border-right: var(--stroke-2) solid var(--ink);
            z-index: 1;
        }

        .fib__s1a {
            grid-column: 3;
            grid-row: 2;
        }

        .fib__s1b {
            grid-column: 3;
            grid-row: 3;
        }

        .fib__mobile-spiral {
            display: block;
            position: absolute;
            grid-column: 1 / 4;
            grid-row: 2 / 4;
            inset: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            transform: scaleX(-1);
            z-index: 0;
        }

        .fib__mobile-spiral path {
            fill: none;
            stroke: var(--ink);
            stroke-width: 3;
            vector-effect: non-scaling-stroke;
        }
    }
</style>
