---
// The Fibonacci spiral over an 8 x 5 tiling (squares 5, 3, 2, 1, 1).
// A cropped viewBox also paints the curve inside animated tile faces.
type Props = {
    viewBox?: string
}

const { viewBox = '0 0 8 5' } = Astro.props
const spiralPath = 'M0 5 A5 5 0 0 1 5 0 A3 3 0 0 1 8 3 A2 2 0 0 1 6 5 A1 1 0 0 1 5 4 A1 1 0 0 1 6 3'
// Exact quarter-circle lengths avoid normalized dash rounding on this small viewBox.
const spiralLength = (Math.PI / 2) * (5 + 3 + 2 + 1 + 1)
const revealId = `spiral-reveal-${crypto.randomUUID()}`
---

<svg
    class="spiral"
    viewBox={viewBox}
    preserveAspectRatio="none"
    aria-hidden="true"
>
    <defs>
        <mask id={revealId} maskUnits="userSpaceOnUse" x="-0.1" y="-0.1" width="8.2" height="5.2">
            <!-- A scaling mask can draw continuously while the visible stroke stays 3px wide. -->
            <path
                class="spiral__draw"
                d={spiralPath}
                style={`--spiral-length: ${spiralLength};`}
                fill="none"
                stroke="white"
                stroke-width="0.1"
            />
        </mask>
    </defs>
    <path class="spiral__line" d={spiralPath} mask={`url(#${revealId})`}></path>
</svg>

<style>
    .spiral {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 0;
    }

    .spiral__line {
        fill: none;
        stroke: var(--ink);
        stroke-width: 3;
        vector-effect: non-scaling-stroke;
    }

    @media (max-width: 760px) {
        .spiral {
            display: none;
        }
    }
</style>
