---
// The Fibonacci spiral over an 8 x 5 tiling (squares 5, 3, 2, 1, 1).
// Place it inside a position: relative container with aspect-ratio 8 / 5.
---

<svg class="spiral" viewBox="0 0 8 5" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0 5 A5 5 0 0 1 5 0 A3 3 0 0 1 8 3 A2 2 0 0 1 6 5 A1 1 0 0 1 5 4 A1 1 0 0 1 6 3"></path>
</svg>

<style>
    .spiral {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 3;
    }

    .spiral path {
        fill: none;
        stroke: var(--ink);
        stroke-width: 3;
        vector-effect: non-scaling-stroke;
    }

    @media (max-width: 760px) {
        .spiral {
            display: none;
        }
    }
</style>
