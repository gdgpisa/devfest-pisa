---
import Base from '@/layouts/Base.astro'
import FibTiling from '@/components/astro/FibTiling.astro'
import Spiral from '@/components/astro/Spiral.astro'

import towerSvg from '@/assets/tower_pisa_gray.svg'
import {
    floorFront, floorLeft, floorRight, floorBounds, floorPoint, floorBase, floorFrontEdge,
} from '@/lib/astro/hero-floor'

const SESSIONIZE_URL = 'https://sessionize.com/devfest-pisa-2027/'
const EVENT_DATE = '10 April 2027'
const CFP_DEADLINE = '14 Feb 2027'
const CONTACT_EMAIL = 'pisagdg+devfest@gmail.com'
const PARTNERSHIP_PROPOSAL_URL =
    'https://docs.google.com/document/d/1bhQtaMDRB_TVt1RcZ4pC9tfezBUHTwxWOg3_d0_Hgzg'

const steps = [
    { n: 1, title: 'Submit', text: `Open now until ${CFP_DEADLINE}.` },
    { n: 2, title: 'Review', text: 'The team reads every proposal.' },
    { n: 3, title: 'Answer', text: 'Speakers hear back as soon as possible, at the latest by 14 Mar 2027.' },
    { n: 4, title: 'On stage', text: `${EVENT_DATE}, in Pisa.` },
]

const stats = [
    { value: '500+', label: 'attendees' },
    { value: '30+', label: 'speakers' },
    { value: '5+', label: "speakers' nations" },
]

---

<Base preloadFont={false}>
    <FibTiling label="DevFest Pisa 2027 is coming">
        <div class="hero-primary">
        <!-- 5-square: title in the corner the spiral turns around -->
        <div class="fib__cell fib__s5">
            <svg class="hero-tower" viewBox="0 0 375.6 685.7" preserveAspectRatio="xMaxYMax meet" aria-hidden="true">
                <defs>
                    <clipPath id="hero-floor-bounds">
                        <rect
                            x={floorBounds.left}
                            y={floorBounds.top}
                            width={floorBounds.right - floorBounds.left}
                            height={floorBounds.bottom - floorBounds.top}
                        />
                    </clipPath>
                    <!-- Fixed front edges hide the moving tower below the perspective plane. -->
                    <clipPath id="hero-tower-opening" clipPathUnits="userSpaceOnUse">
                        <path
                            d={`M${floorBounds.left} ${floorBounds.top}H${floorBounds.right}V${floorRight.y}H${floorRight.x}L${floorPoint(floorFront)}L${floorPoint(floorLeft)}H${floorBounds.left}Z`}
                        />
                    </clipPath>
                    <!-- Original tower contour without its platform, including each column foot. -->
                    <path
                        id="hero-tower-profile"
                        d="M293.1 281.2L292.9 281.5L292.3 302.9L292.5 303.8C296.5 311.3 298.2 317.5 295.8 325C295 327.5 293.9 329.5 293.8 332.2Q293.5 342.9 294 350.8A1 1.1 79.7 0 1 293.2 351.9Q292.4 352.2 291.8 352.7Q291.4 353.1 291.4 353.7L290.7 374.1Q290.7 374.5 290.9 374.8A26 26 0 0 1 293.6 398.6Q292.6 401.1 292.6 402Q292.2 411.8 292.6 421A1 1 79.8 0 1 292 422Q290 422.5 290 424.8Q290 433.7 289.3 440.3C289.3 441.3 289.5 442.7 290.1 443.6C294.3 450.6 296 458.1 293.7 466C292.9 468.7 290.9 471.2 290.9 474Q290.4 502.9 289.9 521.7L289.8 525.8Q289.5 555.5 288.6 584.4C288.4 589.6 282.7 591.4 278.5 589.4Q278 589.2 277.6 589.6L271.9 594.7C269.3 597.1 265.6 599.2 263.3 600.9Q262.9 601.2 262.9 601.7C262.7 605.2 263.4 608.3 259.7 610.4A8 8 0 0 1 250 608.5A2 2 59.6 0 0 248.4 608.1Q233.3 613.5 220.1 615.5L219.5 616.1C218.5 622.5 207.1 623.9 204.9 617.9A1 1 0 0 0 204.1 617.5Q187.6 618.8 171.1 617Q170.3 616.9 169.9 617.7Q168.6 620.7 166.1 621C162.3 621.5 156.1 620.7 155.7 616A1 1 2.4 0 0 154.8 615Q139.8 612.4 125.3 606.7Q124.8 606.5 124.6 607C122.4 613.7 109.7 611 110.9 603.4L111.1 601.1Q111.1 600.6 110.7 600.3Q102.1 594.7 94.8 588.2A3 3 55.2 0 0 92.2 587.7C90 588.6 85.9 589.3 84.2 587.3L84.2 587.2C82.1 584.7 81.4 583.9 81.7 580.2L82.2 568.5Q82.2 568 81.7 567.8Q79.5 566.6 79.1 565Q78.7 563.2 78.9 557.5L79.9 530.7L80.2 526.2Q81.3 498.7 82.2 468.1Q82.3 464.9 81.8 463.6C78.4 455.6 78.4 447.8 82.8 440.4C83.9 438.6 84.9 437.4 85 435.4L85.6 420.4A1 1 19.4 0 0 85.3 419.5Q83.5 418.2 83.5 416.8L84.7 397.4Q84.9 394.4 84.3 393C81 384.6 81.7 376.6 87.5 369.7Q87.8 369.3 87.8 368.7L88.4 347.8Q88.4 347.3 88 347.2Q86.2 346.4 86.3 344.6L87.3 325.3Q87.5 322.3 87 321A21 21 0 0 1 89.9 298.6A2 2 64.6 0 0 90.3 297.3L91 276.8A1 1 0 0 0 90.2 275.6Q89.2 275.1 89.3 273.7Q90 264.5 90.5 253.1Q90.7 251.3 90.1 249.6Q84.9 237.1 93.1 226.5L93.4 225.8L94.1 204.9A1 1 17.9 0 0 93.6 203.9C92.5 203.2 92.2 202.6 92.3 201Q92.7 189.1 93.3 181.4C93.8 177.2 91.8 174.8 91.5 170.7Q90.8 162.5 96 155.8C96.7 154.8 97 154.1 97 152.8Q97.2 135.5 97.7 117.8C97.9 112.9 97.1 108 97.2 104.1C97.5 87.5 114.5 75.3 128.7 69.5A1 1 0 0 0 129.5 68.4Q129.5 59.7 129.9 49.4Q129.9 48 129.4 47.1Q123.8 36.5 128 27.2C133.3 15.3 151.5 7.2 164 4.1Q200.6 -4.9 236.7 5.9Q250.4 9.9 261.4 18.6C269.8 25.2 274.8 34.1 271.4 45.1Q271 46.5 269.6 49.4Q268.6 51.6 268.6 53.9L268.1 70.1A2 2 18 0 0 268.8 71.4L276.1 76.2Q287.6 83.3 295.1 96.2A28 28 0 0 1 298.4 115C298 117 297.4 119.8 297.4 122.5Q297 136.6 296.6 142.5C296.4 144.4 295.4 146.5 295.4 148.7Q295.4 152.3 294.9 159.8A3 3 28.2 0 0 295.4 161.5A23 23 0 0 1 298 183.5Q297.1 185.9 297 188.5Q296.7 199.9 297.1 206.8Q297.2 208.3 295.6 209Q294.6 209.5 294.5 210.7L293.5 231.1L293.8 231.7Q301.1 243.2 296.4 254.9Q295.4 257.3 295.4 259.9Q295 273.1 295.6 279.1Q295.6 279.6 295.2 279.9Z"
                    />
                    <mask id="hero-tower-body" maskUnits="userSpaceOnUse" x="-4" y="-4" width="384" height="635">
                        <use href="#hero-tower-profile" fill="white" />
                    </mask>
                    <filter id="hero-tower-ink" color-interpolation-filters="sRGB">
                        <feFlood flood-color="var(--hero-tower-line)" />
                        <feComposite in2="SourceAlpha" operator="in" />
                    </filter>
                </defs>
                <g class="hero-ground" clip-path="url(#hero-floor-bounds)">
                    <use class="hero-ground__tiles" href="/hero-floor.svg#tiles" />
                    <use class="hero-ground__lines" href="/hero-floor.svg#lines" />
                </g>
                <path class="hero-base" d={floorBase} />
                <path class="hero-base__opening" d={floorBase} />
                <g class="hero-tower__reveal">
                    <g class="hero-tower__lift">
                        <use class="hero-tower__surface" href="#hero-tower-profile" />
                        <use class="hero-tower__drawing" href={`${towerSvg.src}#pisa-tower`} width="375.6" height="685.7" />
                    </g>
                </g>
                <path class="hero-base hero-base--front" d={floorFrontEdge} />
            </svg>
            <div class="eyebrow muted">Save the date · {EVENT_DATE}</div>
            <h1 class="hero-title">DevFest Pisa<br />is back.</h1>
            <p class="hero-text">Tickets open later. Right now we are looking for speakers and sponsors.</p>
        </div>

        <!-- 3-square: Call for Speakers, curtain reveal on hover -->
        <a class="fib__s3 box box--speakers" href="#speakers">
            <span class="face">
                <span class="eyebrow">Open now</span>
                <span>
                    <span class="box-title">Call for Speakers</span>
                    <span class="box-hint">Got a talk in mind? <span class="arrow">→</span></span>
                </span>
            </span>
            <span class="face curtain">
                <Spiral viewBox="5 0 3 3" />
                <span class="eyebrow curtain__eyebrow">Call for Papers · Open</span>
                <span>
                    <span class="curtain__title">Got a talk in mind? The Call for Papers is open.</span>
                    <span class="curtain__text">Send us your proposal. First talk or tenth, it is welcome.</span>
                    <span class="curtain__action">Submit on Sessionize <span class="arrow">→</span></span>
                </span>
            </span>
        </a>
        </div>

        <!-- 2-square: Call for Sponsors, flips on hover -->
        <a class="fib__s2 box flip" href="#sponsors">
            <span class="flip-in">
                <span class="face flip__front">
                    <Spiral viewBox="6 3 2 2" />
                    <span class="flip__title">Call for Sponsors</span>
                    <span class="flip__hint">Want a table at the event? <span class="arrow">→</span></span>
                </span>
                <span class="face flip__back">
                    <Spiral viewBox="6 3 2 2" />
                    <span class="eyebrow flip__eyebrow">Call for Sponsors</span>
                    <span class="flip__copy">
                        <span class="flip__question">
                            Would your company like to take part, or have a table at the event?
                        </span>
                        <span class="flip__cta">Get in touch <span class="arrow">→</span></span>
                    </span>
                </span>
            </span>
        </a>

        <div class="fib__cell fib__s1a"></div>
        <div class="fib__cell fib__s1b"></div>
    </FibTiling>

    <!-- Call for Speakers -->
    <section id="speakers" class="wrap section">
        <div class="section-head">
            <div class="section-head__text">
                <div class="eyebrow text-blue">Call for Speakers</div>
                <h2 class="h2">Got a talk in mind? The Call for Papers is open.</h2>
                <p class="lead">
                    Send us your proposal: a title and a short abstract are enough. Experienced speaker or first talk
                    ever, we want to hear from you.
                </p>
            </div>
            <a class="dp-btn" href={SESSIONIZE_URL}>Submit on Sessionize</a>
        </div>

        <div class="dp-strip">
            <div class="dp-strip__item">
                <div class="eyebrow muted">Tracks</div>
                <div class="tags">
                    <span class="dp-tag dp-tag--ai">AI</span>
                    <span class="dp-tag">Web</span>
                    <span class="dp-tag dp-tag--mobile">Mobile</span>
                    <span class="dp-tag dp-tag--cloud">Cloud</span>
                    <span class="dp-tag dp-tag--other">Other</span>
                </div>
            </div>
            <div class="dp-strip__item">
                <div class="eyebrow muted">Formats</div>
                <div class="strip-value">Talk · Workshop</div>
                <div class="body muted">Talk 25 or 45 min · Workshop 1h+</div>
            </div>
            <div class="dp-strip__item">
                <div class="eyebrow muted">Deadline</div>
                <div class="strip-value">Call closes {CFP_DEADLINE}</div>
            </div>
        </div>

        <ol class="steps">
            {
                steps.map(step => (
                    <li class="step">
                        <div class:list={['step__n', { 'text-blue': step.n === 1 }]}>{step.n}</div>
                        <div class="strip-value">{step.title}</div>
                        <div class="body muted">{step.text}</div>
                    </li>
                ))
            }
        </ol>
    </section>

    <!-- Call for Sponsors -->
    <section id="sponsors" class="field field--yellow">
        <div class="wrap section">
            <div class="section-head">
                <div class="section-head__text">
                    <div class="eyebrow">Call for Sponsors</div>
                    <h2 class="h2">Want your company at DevFest Pisa?</h2>
                    <p class="lead">
                        Whether you want to support the event or have a table to meet attendees, get in touch with us.
                        DevFest is free for everyone thanks to its sponsors.
                    </p>
                </div>
                <div class="sponsor-actions">
                    <a class="dp-btn" href={`mailto:${CONTACT_EMAIL}`}>Get in touch</a>
                    <a class="body sponsor-actions__link" href={PARTNERSHIP_PROPOSAL_URL}
                        >Download the partnership proposal</a
                    >
                    <span class="caption mono">{CONTACT_EMAIL}</span>
                </div>
            </div>

            <div class="stats">
                <div class="dp-strip">
                    {
                        stats.map(stat => (
                            <div class="dp-strip__item">
                                <div class="dp-strip__value">{stat.value}</div>
                                <div class="dp-strip__label">{stat.label}</div>
                            </div>
                        ))
                    }
                </div>
                <span class="caption">Numbers of last DevFest Pisa, as published on the event site.</span>
            </div>
        </div>
    </section>
</Base>

<style>
    .hero-primary {
        display: contents;
    }

    .fib__s1a {
        background: var(--green);
    }

    .fib__s1b {
        background: var(--red);
    }

    /* Hero: 5-square */
    /* Keep the decorative tower behind the complete introduction. */
    .fib__s5 > .hero-tower {
        position: absolute;
        bottom: 0;
        opacity: 0.18;
        z-index: 0;
        pointer-events: none;
    }

    @media (min-width: 761px) {
        .fib__s5 > .hero-tower {
            left: 50%;
            translate: -50% 0;
            width: auto;
            /* Fit the tower's outline below the spiral, including its stroke. */
            height: calc(84.5% - 6px);
        }
    }

    .hero-ground,
    .hero-base,
    .hero-base__opening,
    .hero-tower__surface {
        display: none;
    }

    .hero-tower__lift {
        animation: hero-tower-rise 1.8s cubic-bezier(0.22, 0.68, 0, 1) 120ms both;
    }

    .hero-base__opening {
        opacity: 0;
    }

    @keyframes hero-tower-rise {
        from {
            transform: translateY(690px);
        }
        to {
            transform: translateY(0);
        }
    }

    @keyframes hero-opening-shade {
        0%, 65% {
            opacity: 1;
        }
        100% {
            opacity: 0;
        }
    }

    .fib__s5.fib__cell {
        gap: var(--space-34);
    }

    .hero-title {
        margin: 0;
        font: 700 clamp(40px, 5vw, 89px) / 1 var(--font-sans);
        letter-spacing: -0.03em;
    }

    .hero-text {
        margin: 0;
        font: 400 clamp(15px, 1.3vw, 19px) / 1.5 var(--font-sans);
        max-width: 19em;
    }

    /* CallBoxes */
    .box {
        position: relative;
        overflow: hidden;
        display: block;
        text-decoration: none;
        color: var(--on-blue);
        min-width: 0;
    }

    .box:hover {
        color: var(--on-blue);
    }

    .box:focus-visible {
        outline: var(--space-3) solid var(--focus);
        outline-offset: -6px;
    }

    .face {
        position: absolute;
        inset: 0;
        padding: clamp(16px, 2.6vw, 55px);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        z-index: 1;
    }

    .face > span {
        position: relative;
        z-index: 1;
    }

    .arrow {
        display: inline-block;
        transition: transform 0.3s;
    }

    .box:focus-visible .arrow {
        transform: translateX(5px);
    }

    /* Call for Speakers: curtain */
    .box--speakers {
        background: var(--blue);
    }

    .box-title {
        display: block;
        font: 700 clamp(34px, 4.6vw, 80px) / 0.92 var(--font-sans);
        letter-spacing: -0.04em;
    }

    .box-hint {
        display: block;
        font: 500 clamp(16px, 1.5vw, 21px) / 1.3 var(--font-sans);
        margin-top: var(--space-13);
    }

    .curtain {
        background: var(--reveal);
        color: var(--surface);
        transform: translateY(101%);
        transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
        z-index: 2;
        overflow-y: auto;
        justify-content: flex-start;
        gap: var(--space-13);
    }

    .box:focus-visible .curtain {
        transform: translateY(0);
    }

    .curtain__eyebrow {
        color: var(--pastel-blue);
    }

    .curtain__title {
        display: block;
        font: 700 clamp(26px, 3vw, 52px) / 1 var(--font-sans);
        letter-spacing: -0.03em;
    }

    .curtain__text {
        display: block;
        font: 400 clamp(15px, 1.3vw, 19px) / 1.5 var(--font-sans);
        margin-top: var(--space-13);
        color: var(--hairline);
    }

    .curtain__action {
        display: inline-block;
        margin-top: var(--space-21);
        font: 500 16px/26px var(--font-sans);
        border: var(--stroke-2) solid var(--surface);
        border-radius: var(--radius-pill);
        padding: var(--space-8) var(--space-21);
    }

    /* Call for Sponsors: flip */
    .flip {
        perspective: 1400px;
        color: var(--ink);
        z-index: 1;
    }

    .flip:hover {
        color: var(--ink);
    }

    .flip-in {
        position: absolute;
        inset: 0;
        transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.2, 1);
        transform-style: preserve-3d;
    }

    .flip:focus-visible .flip-in {
        transform: rotateY(180deg);
    }

    @media (hover: hover) and (pointer: fine) {
        .box:hover .arrow {
            transform: translateX(5px);
        }

        .box:hover .curtain {
            transform: translateY(0);
        }

        .flip:hover .flip-in {
            transform: rotateY(180deg);
        }
    }

    .flip .face {
        backface-visibility: hidden;
        -webkit-backface-visibility: hidden;
    }

    .flip__front {
        background: var(--yellow);
        justify-content: flex-start;
    }

    .flip__title {
        display: block;
        font: 700 clamp(21px, 2.6vw, 44px) / 0.95 var(--font-sans);
        letter-spacing: -0.03em;
    }

    .flip__hint {
        display: block;
        font: 500 clamp(13px, 1.2vw, 16px) / 1.4 var(--font-sans);
        margin-top: var(--space-8);
    }

    .flip__back {
        transform: rotateY(180deg);
        background: var(--reveal);
        color: var(--surface);
        justify-content: flex-start;
        gap: var(--space-8);
    }

    .flip__back {
        overflow-y: auto;
    }

    .curtain > *,
    .flip__back > * {
        flex-shrink: 0;
    }

    .flip__eyebrow,
    .flip__cta {
        color: var(--yellow);
    }

    .flip__copy {
        max-width: 15em;
    }

    .flip__question {
        display: block;
        font: 700 clamp(16px, 1.7vw, 26px) / 1.15 var(--font-sans);
        letter-spacing: -0.02em;
    }

    .flip__cta {
        display: block;
        font: 500 clamp(13px, 1.2vw, 16px) / 1.4 var(--font-sans);
        margin-top: var(--space-13);
    }

    @media (max-width: 760px) {
        .hero-primary {
            --hero-blue-deep: #184bc1;
            --hero-tower-line: #5987ff;
            display: flex;
            flex-direction: column;
            position: relative;
            overflow: hidden;
            background: var(--blue);
            color: var(--on-blue);
            border-bottom: var(--stroke-2) solid var(--ink);
        }

        .fib__s5.fib__cell {
            position: static;
            overflow: visible;
            padding: clamp(12px, 3svh, 34px) 7vw 0;
            align-items: flex-start;
            justify-content: flex-start;
            text-align: left;
            gap: clamp(8px, 2svh, 21px);
            border: 0;
        }

        .fib__s5 .eyebrow {
            color: inherit;
        }

        .fib__s5 > :not(.hero-tower) {
            z-index: 1;
        }

        /* Soften the artwork only behind the lettering, not across the blue tile. */
        .fib__s5 > :not(.hero-tower),
        .box--speakers > .face:not(.curtain) {
            text-shadow:
                0 0 var(--space-3) var(--blue),
                0 0 var(--space-8) var(--blue),
                0 0 var(--space-13) var(--blue);
        }

        .fib__s5 > .hero-tower {
            left: auto;
            right: -4%;
            width: 70%;
            height: 80%;
            opacity: 1;
            overflow: visible;
        }

        .hero-tower__reveal {
            clip-path: url(#hero-tower-opening);
        }

        .hero-tower__drawing {
            filter: url(#hero-tower-ink);
            opacity: 1;
            mask: url(#hero-tower-body);
        }

        .hero-ground,
        .hero-base,
        .hero-base__opening,
        .hero-tower__surface {
            display: inline;
        }

        .hero-ground__tiles {
            fill: var(--hero-blue-deep);
        }

        .hero-ground__lines {
            fill: none;
            stroke: color-mix(in srgb, var(--on-blue) 6%, transparent);
            stroke-width: 0.8;
        }

        .hero-base {
            fill: var(--hero-blue-deep);
            stroke: var(--hero-tower-line);
            stroke-width: 2.4;
            opacity: 1;
        }

        .hero-base--front {
            fill: none;
        }

        .hero-base__opening {
            fill: color-mix(in srgb, var(--hero-blue-deep) 70%, var(--ink));
            animation: hero-opening-shade 1.8s linear 120ms both;
        }

        .hero-tower__surface {
            fill: var(--hero-blue-deep);
        }

        .flip__front {
            background: transparent;
        }

        .box--speakers {
            background: transparent;
            border: 0;
            flex: 1;
            min-height: 0;
            z-index: 1;
        }

        .box--speakers > .face:not(.curtain) {
            position: relative;
            height: 100%;
            gap: clamp(6px, 1.5svh, 21px);
            justify-content: flex-end;
        }

        .hero-title {
            font-size: clamp(34px, min(11.5vw, 8svh), 68px);
            line-height: 1.02;
            letter-spacing: -0.04em;
        }

        .hero-text {
            max-width: 22ch;
            font-size: clamp(15px, min(4.1vw, 2.8svh), 18px);
            line-height: 1.5;
            text-wrap: pretty;
        }

        .face {
            padding: clamp(12px, 3svh, 34px) 7vw;
        }

        .box-title {
            max-width: 6em;
            font-size: clamp(24px, min(8vw, 5.5svh), 48px);
            line-height: 1.05;
        }

        .box-hint {
            font-size: clamp(15px, min(4vw, 3svh), 20px);
            margin-top: var(--space-8);
        }

        .flip__front {
            align-items: flex-end;
            text-align: right;
        }

        .flip__title {
            font-size: clamp(24px, min(7vw, 4.5svh), 44px);
            line-height: 1.05;
        }

        .flip__hint {
            max-width: 14ch;
