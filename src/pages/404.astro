---
import Base from '@/layouts/Base.astro'
import FibTiling from '@/components/astro/FibTiling.astro'
---

<Base title="404 - Page Not Found">
    <FibTiling label="Page not found">
        <!-- 5-square: the number and the exception, in the corner the spiral turns around -->
        <div class="fib__cell fib__s5">
            <div class="eyebrow muted">Code Exception</div>
            <h1 class="code-404">404</h1>
            <pre
                class="code-block"><code><span class="kw">try</span> <span>&#123;</span>
<span class="indent"><span class="kw">await</span> navigateTo(<span class="str">"<span id="requested-url">/your-requested-page</span>"</span>);</span>
<span>&#125;</span> <span class="kw">catch</span> (error) <span>&#123;</span>
<span class="indent">console.error(<span class="str" id="random-error-message">"404: Route not registered in the DevFest manifest."</span>);</span>
<span>&#125;</span></code></pre>
        </div>

        <!-- 3-square: the way back -->
        <a class="fib__cell fib__s3 home-link" href="/">
            <span class="eyebrow">Return to Homepage</span>
            <span class="home-link__cmd">&gt; <span id="random-button-text">git checkout main</span></span>
            <span class="home-link__arrow" aria-hidden="true">→</span>
        </a>

        <div class="fib__cell fib__s2" style="background: var(--yellow);"></div>
        <div class="fib__cell fib__s1a" style="background: var(--green);"></div>
        <div class="fib__cell fib__s1b" style="background: var(--red);"></div>
    </FibTiling>

    <script>
        // Random phrases for the 404 page
        const phrases = [
            '"404: Route not registered in the DevFest manifest."',
            '"404: The requested speaker is currently offline."',
            '"404: NullPointerException - Page is out of bounds."',
            '"Error: Uncaught Promise Rejection. Page not found."',
            '"404: Looks like a broken pipeline in GitHub Actions."',
            '"Warning: this track has been deprecated."',
        ]

        const messageElement = document.getElementById('random-error-message')
        if (messageElement) {
            const randomPhrase = phrases[Math.floor(Math.random() * phrases.length)]
            messageElement.textContent = randomPhrase
        }

        // Random phrases for the button text
        const buttonPhrases = [
            'git checkout main',
            'cd /home',
            'npm run start',
            'docker restart devfest',
            'sudo reboot',
            'Ctrl+Z',
            'git reset --hard HEAD',
            'rm -rf node_modules',
        ]

        const buttonTextElement = document.getElementById('random-button-text')
        if (buttonTextElement) {
            const randomBtnPhrase = buttonPhrases[Math.floor(Math.random() * buttonPhrases.length)]
            buttonTextElement.textContent = randomBtnPhrase
        }

        const urlElement = document.getElementById('requested-url')
        if (urlElement) {
            urlElement.textContent = window.location.pathname
        }
    </script>
</Base>

<style>
    .code-404 {
        margin: 0;
        font: 700 clamp(89px, 13vw, 233px) / 0.85 var(--font-numeral);
        letter-spacing: -0.05em;
        font-variant-numeric: tabular-nums;
    }

    .code-block {
        margin: 0;
        max-width: 36em;
        padding: var(--space-21);
        text-align: left;
        white-space: pre-wrap;
        font: 400 clamp(13px, 1.2vw, 16px) / 1.6 var(--font-mono);
        background: var(--surface);
        border: var(--stroke-2) solid var(--ink);
    }

    .code-block .indent {
        padding-left: 2em;
    }

    .code-block .kw {
        color: var(--blue-text);
        font-weight: 500;
    }

    .code-block .str {
        color: var(--red-text);
    }

    /* 3-square: content sits bottom left, where the spiral turns */
    .home-link {
        justify-content: flex-end;
        gap: var(--space-13);
        background: var(--blue);
        color: var(--on-blue);
        text-decoration: none;
    }

    .home-link:hover {
        color: var(--on-blue);
    }

    .home-link:focus-visible {
        outline: var(--space-3) solid var(--focus);
        outline-offset: -6px;
    }

    .home-link__cmd {
        font: 500 clamp(21px, 2.6vw, 44px) / 1.1 var(--font-mono);
        letter-spacing: -0.02em;
    }

    .home-link__arrow {
        display: inline-block;
        font: 700 clamp(21px, 2.6vw, 44px) / 1 var(--font-sans);
        transition: transform 0.3s;
    }

    .home-link:hover .home-link__arrow,
    .home-link:focus-visible .home-link__arrow {
        transform: translateX(5px);
    }

    @media (prefers-reduced-motion: reduce) {
        .home-link__arrow {
            transition: none;
        }
    }

    @media (max-width: 760px) {
        .fib__s2,
        .fib__s1a,
        .fib__s1b {
            display: none;
        }
    }
</style>
