---
import Base from '@/layouts/Base.astro'
import PageHead from '@/components/astro/PageHead.astro'
import { Picture } from 'astro:assets'

function snakecaseToTitleCase(str: string) {
    return str
        .split('_')
        .map(word => word.charAt(0).toUpperCase() + word.slice(1))
        .join(' ')
}

const memberPictures: { default: ImageMetadata }[] = await Promise.all(
    Object.entries(import.meta.glob<{ default: ImageMetadata }>('@/assets/team/*')).map(([_name, picture]) =>
        picture(),
    ),
)

const nameOverrides: Record<string, { firstName: string; lastName: string }> = {
    davide_pio_lomonaco: { firstName: 'Davide Pio', lastName: 'Lomonaco' },
}

const extractFileName = (src: string) => src.split('/').at(-1)!.split('?')[0].split('.')[0]

const parseNameParts = (fileName: string): { firstName: string; lastName: string } => {
    if (nameOverrides[fileName]) {
        return nameOverrides[fileName]
    }

    const nameParts = snakecaseToTitleCase(fileName).split(' ')
    return {
        firstName: nameParts.at(0)!,
        lastName: nameParts.slice(1).join(' '),
    }
}

const teamMembers = memberPictures
    .map(picture => {
        const fileName = extractFileName(picture.default.src)
        const { firstName, lastName } = parseNameParts(fileName)

        return {
            fullName: snakecaseToTitleCase(fileName),
            firstName,
            lastName,
            picture,
        }
    })
    .toSorted((a, b) => a.lastName.localeCompare(b.lastName))
---

<Base
    title="Team - DevFest Pisa 2027"
    description="Meet the organizers and volunteers behind DevFest Pisa 2027, hosted at MACC in Pisa on 10 April 2027."
>
    <PageHead title="Team" />
    <section id="team" class="wrap section">
        <ul class="people">
            {
                teamMembers.map((member, index) => {
                    const maxWidth = Math.min(450, member.picture.default.width, member.picture.default.height)
                    return (
                        <li class="person">
                            <Picture
                                src={member.picture.default}
                                alt={`Picture of ${member.fullName}`}
                                width={220}
                                height={220}
                                fit="cover"
                                formats={['avif']}
                                fallbackFormat="webp"
                                widths={[180, 220, 270, 320, 360, maxWidth].filter(width => width <= maxWidth)}
                                sizes="(max-width: 760px) calc(50vw - 26.5px), 218px"
                                priority={index < 2}
                            />
                            <h2 class="person__name">
                                <span>{member.firstName}</span>
                                <span>{member.lastName}</span>
                            </h2>
                        </li>
                    )
                })
            }
        </ul>
    </section>
</Base>

<style>
    .people {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: var(--space-34) var(--space-21);
    }

    .person {
        display: flex;
        flex-direction: column;
        gap: var(--space-13);
        min-width: 0;
    }

    .person img {
        display: block;
        width: 100%;
        height: auto;
        aspect-ratio: 1;
        object-fit: cover;
        border: var(--stroke-2) solid var(--ink);
        background: var(--surface-raised);
    }

    .person__name {
        margin: 0;
        display: flex;
        flex-direction: column;
        font: 500 21px/28px var(--font-sans);
    }

    .person__name span:last-child {
        font-weight: 700;
    }

    @media (max-width: 760px) {
        .people {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }
</style>
