---
import '@/styles/tokens.css'
import '@/styles/ds-components.css'
import '@/styles/site.css'

import Footer from '@/components/astro/Footer.astro'
import Header from '@/components/astro/Header.astro'

type Props = {
    title?: string
}

const { title = 'DevFest Pisa 2027' } = Astro.props

const ogImage = new URL('/og-image.png', Astro.site ?? Astro.url)
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />

        <meta property="og:title" content={title} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="DevFest Pisa, 10 April 2027, MACC, Pisa" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta
            property="og:description"
            content={`Unisciti alla DevFest Pisa, l'evento che riunisce la community tech per crescere e innovare insieme!
                 Talk ispirazionali, workshop pratici e networking con esperti del settore. Perché solo insieme possiamo
                 costruire il futuro della tecnologia! 🚀`.replace(/\s+/g, ' ')}
        />

        <!-- Address Bar Color -->
        <meta name="theme-color" content="#ffbf00" />
        <meta name="apple-mobile-web-app-status-bar-style" content="#ffbf00" />

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            rel="stylesheet"
            href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@6..144,400..700&family=Google+Sans+Code:wght@400;500&display=swap"
        />

        <script defer src="https://cloud.umami.is/script.js" data-website-id="6a2d9e3e-6360-4797-b976-e15276cc1d42"
        ></script>

        <title>{title}</title>
    </head>
    <body>
        <Header />
        <main id="top">
            <slot />
        </main>
        <Footer />
    </body>
</html>
