---
import Base from '@/layouts/Base.astro'
---

<Base>
    <section class="wrap section">
        <article class="prose">
            <slot />
        </article>
    </section>
</Base>

<style>
    .prose {
        max-width: 760px;
        font: 400 16px/26px var(--font-sans);
    }

    .prose :global(h2) {
        margin: 0 0 var(--space-34);
        font: 700 clamp(40px, 5.5vw, 89px) / 0.95 var(--font-sans);
        letter-spacing: -0.04em;
        text-wrap: balance;
    }

    .prose :global(h3) {
        margin: var(--space-55) 0 var(--space-13);
        font: 700 34px/40px var(--font-sans);
        letter-spacing: -0.01em;
    }

    /* FAQ questions: ruled rows, like the agenda */
    .prose :global(h4) {
        margin: var(--space-34) 0 var(--space-8);
        padding-top: var(--space-21);
        border-top: var(--stroke-2) solid var(--ink);
        font: 500 21px/28px var(--font-sans);
    }

    .prose :global(p),
    .prose :global(ul),
    .prose :global(ol) {
        margin: 0 0 var(--space-21);
    }

    .prose :global(blockquote) {
        margin: 0;
        padding: 0;
        color: var(--ink-muted);
    }

    .prose :global(blockquote p) {
        margin: 0;
    }

    .prose :global(a) {
        color: var(--blue-text);
    }

    .prose :global(strong) {
        font-weight: 700;
        color: var(--ink);
    }

    .prose :global(li) {
        margin-bottom: var(--space-8);
    }

    .prose :global(code) {
        font: 400 0.9em var(--font-mono);
    }
</style>
